# WhatsApp Web Production Environment Variables
# Copy this file to .env before starting the server

# Server Port
PORT=5050

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# MongoDB Database URI
MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_db

# JWT Configuration
JWT_SECRET=whatsapp_super_secure_jwt_secret_production_2026_xyz987
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Client Application URL
CLIENT_URL=http://localhost:5050

# Local Storage Uploads Directory
UPLOADS_DIR=uploads

# Optional Redis Cache / Socket Adapter (fallback in-memory when empty)
REDIS_URI=

# Optional OpenAI / External LLM API Key (RAG service falls back to local knowledge engine)
OPENAI_API_KEY=
